NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — wajib untuk cron auto-hapus video interview
# Ambil dari Supabase → Settings → API → service_role (jangan expose ke browser)
SUPABASE_SERVICE_ROLE_KEY=
# String acak kuat; Vercel Cron mengirim Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# AI — required for CV screening / interview AI
# Di Vercel: Settings → Environment Variables → nama HARUS exact:
#   OPENROUTER_API_KEY
# Centang Production (+ Preview), lalu Redeploy.
# Jangan pakai tanda kutip di value.
OPENROUTER_API_KEY=
# Optional aliases also accepted: AI_API_KEY
# Optional overrides:
# AI_PROVIDER=openrouter
# Default model di kode: x-ai/grok-4.5 — override di Vercel bila perlu:
# AI_MODEL=x-ai/grok-4.5
# Model khusus CV screening (ekstraksi) — default murah/cepat:
# AI_SCREENING_MODEL=google/gemini-3-flash-preview
# AI_VISION_MODEL=google/gemini-2.5-flash
# AI_BASE_URL=
# OPENCODE_API_KEY=
#
# Wajib untuk AI screening background (update skor setelah create cepat):
# SUPABASE_SERVICE_ROLE_KEY=...
# CRON_SECRET=... (atau pakai service role sebagai bearer internal)

# Speech-to-text fallback untuk browser tanpa Web Speech API (Firefox/Safari).
# Kandidat tetap rekam video seperti biasa; server mentranskrip audio jawaban.
# Prioritas: Groq (gratis, cepat) → OpenAI. Tanpa key, fitur ini diam nonaktif.
# GROQ_API_KEY=          (https://console.groq.com)
# GROQ_STT_MODEL=whisper-large-v3-turbo
# OPENAI_API_KEY=        (https://platform.openai.com — dipakai juga untuk TTS)
# OPENAI_STT_MODEL=whisper-1

# TTS untuk conversational interview (AI berbicara ke kandidat)
# Butuh OPENAI_API_KEY di atas. Tanpa key, kandidat melihat teks saja (fallback).
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=nova         (alloy/ash/ballad/coral/echo/fable/onyx/nova/sage/shimmer)

# Email transaksional (undangan tim & link interview) — via Resend (https://resend.com)
# Tanpa key ini, app tetap jalan tapi invite fallback ke copy-link manual.
RESEND_API_KEY=
# Alamat pengirim. Default: "Cullr <onboarding@resend.dev>" (hanya untuk testing).
# Production: verifikasi domain di Resend, lalu mis: Cullr <no-reply@domainanda.com>
# EMAIL_FROM=
