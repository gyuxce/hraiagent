NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI — required for CV screening / interview AI
# Di Vercel: Settings → Environment Variables → nama HARUS exact:
#   OPENROUTER_API_KEY
# Centang Production (+ Preview), lalu Redeploy.
# Jangan pakai tanda kutip di value.
OPENROUTER_API_KEY=
# Optional aliases also accepted: AI_API_KEY
# Optional overrides:
# AI_PROVIDER=openrouter
# AI_MODEL=deepseek/deepseek-v4-flash
# AI_BASE_URL=
# OPENCODE_API_KEY=
